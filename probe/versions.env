# The versions of the participants the saved columns were measured against. Without this file the
# setup would install "whatever is latest", so a run a month later would measure something else
# while the saved columns still claimed to describe it.
#
# Changing a version here means changing the matching column in <NAME>.txt too — otherwise the
# snapshot and the environment describe different things.

DUCKDB_VERSION=1.5.5
PYARROW_VERSION=25.0.1            # Acero arrives with it
SUBSTRAIT_PYTHON_VERSION=0.31.0
SUBSTRAIT_ANTLR_VERSION=0.103.0
SUBSTRAIT_EXTENSIONS_VERSION=0.99.0
PROTOBUF_RUNTIME_VERSION=7.36.1   # to build the validator from main: gencode 7.36 against its <7 pin

# substrait-go: the major version is part of the import path, so @main without a commit is not
# reproducible.
SUBSTRAIT_GO_MODULE=github.com/substrait-io/substrait-go/v9
SUBSTRAIT_GO_COMMIT=v9.0.0-alpha.0.0.20260902180101-cb2d6e648bc0

# The two checkouts the harness is pointed at. probe/reverify.sh requires these commits unless
# SJ_EXPECT or DF_EXPECT says otherwise, so the pin is applied by the ordinary run rather than only
# written down. SUBSTRAIT_JAVA_COMMIT is what the substrait-java and Isthmus columns were taken
# against; note that it is not the tip of that project's main.
SUBSTRAIT_JAVA_COMMIT=fff6390
DATAFUSION_COMMIT=f96892a9b

# Built from source; the commit is pinned here
SUBSTRAIT_VALIDATOR_COMMIT=2a10470
GLUTEN_COMMIT=f7f5f04
GLUTEN_IMAGE=apache/gluten:centos-9-jdk17

# Spark: the variants :spark is built against
SPARK_34=3.4.4
SPARK_35=3.5.4
SPARK_40=4.0.2

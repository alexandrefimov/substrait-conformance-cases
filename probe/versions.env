# The versions of the participants the saved columns were measured against. Without this file the
# setup would install "whatever is latest", so a run a month later would measure something else
# while the saved columns still claimed to describe it.
#
# Changing a version here means changing the matching column in <NAME>.txt too — otherwise the
# snapshot and the environment describe different things.

DUCKDB_VERSION=1.5.5
# The substrait extension is a community build, and `INSTALL substrait FROM community` takes no
# version: whatever that repository serves for this DuckDB release is what arrives. So the version
# is recorded rather than requested, and probe/replay_column.sh reads it back out of
# duckdb_extensions() and refuses to call a run a reproduction when it has moved. Without this the
# column could change for a reason the file does not mention.
DUCKDB_SUBSTRAIT_EXTENSION=4ea63dd
PYARROW_VERSION=25.0.1            # Acero arrives with it
SUBSTRAIT_PYTHON_VERSION=0.31.0
SUBSTRAIT_ANTLR_VERSION=0.103.0
SUBSTRAIT_EXTENSIONS_VERSION=0.99.0
PROTOBUF_RUNTIME_VERSION=7.36.1   # to build the validator from main: gencode 7.36 against its <7 pin

# The Go the probe module needs. substrait-go itself declares go 1.23.0, and setup.sh builds with
# GOTOOLCHAIN=local so that a run cannot silently fetch a different toolchain - which means the go on
# PATH has to satisfy this by itself. Ubuntu 24.04 ships 1.22 and does not.
GO_MINIMUM=1.23

# substrait-go: the major version is part of the import path, so @main without a commit is not
# reproducible.
SUBSTRAIT_GO_MODULE=github.com/substrait-io/substrait-go/v9
SUBSTRAIT_GO_COMMIT=v9.0.0-alpha.0.0.20260902180101-cb2d6e648bc0

# The two checkouts the harness is pointed at. probe/reverify.sh requires these commits unless
# SJ_EXPECT or DF_EXPECT says otherwise, so the pin is applied by the ordinary run rather than only
# written down. SUBSTRAIT_JAVA_COMMIT is what the substrait-java and Isthmus columns were taken
# against; note that it is not the tip of that project's main.
SUBSTRAIT_JAVA_COMMIT=fff6390
# The JDK the substrait-java columns were measured with. Its build accepts others; this is the one
# the saved columns came from and the one CI installs, so a difference in the answers cannot be a
# difference in the toolchain nobody wrote down. Spark is separate and wants exactly 17, below.
JAVA_VERSION=17
DATAFUSION_COMMIT=cc29ea12a

# Built from source; the commit is pinned here. The version beside it is what that commit's package
# metadata declares, recorded rather than requested - like the DuckDB extension, it is read back out
# of the built environment, so a build that produced something else is noticed instead of quietly
# compared against the saved column.
SUBSTRAIT_VALIDATOR_COMMIT=2a10470
SUBSTRAIT_VALIDATOR_VERSION=0.1.4
GLUTEN_COMMIT=f7f5f04
GLUTEN_IMAGE=apache/gluten:centos-9-jdk17

# Spark: the variants :spark is built against
SPARK_34=3.4.4
SPARK_35=3.5.4
SPARK_40=4.0.2

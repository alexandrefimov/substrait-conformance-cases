# versions.env with the four installable participants unpinned. LATEST=1 probe/replay_column.sh
# passes this file to setup.sh, and the run then answers a different question: not "does the saved
# column reproduce" but "has the participant moved since that column was taken".
#
# Everything else keeps its pin. The two checkouts, the validator and Gluten are not installed down
# this path, and floating them here would only make this file disagree with versions.env about
# things it never changes.
#
# `latest` rather than an empty value: setup.sh has to tell "no pin was asked for" from "the
# variable is missing", and an empty string under `set -u` looks like both.
. "$(dirname "${BASH_SOURCE[0]}")/versions.env"

DUCKDB_VERSION=latest
DUCKDB_SUBSTRAIT_EXTENSION=latest
PYARROW_VERSION=latest
SUBSTRAIT_PYTHON_VERSION=latest
# substrait-python is measured with the antlr runtime and the packaged extensions beside it, so
# floating it alone would ask what today's substrait-python does against last September's extensions.
SUBSTRAIT_ANTLR_VERSION=latest
SUBSTRAIT_EXTENSIONS_VERSION=latest
# @main, not @latest. The pin is a pseudo-version - a commit on main after the v9.0.0-alpha.0 tag -
# and go resolves @latest to the newest TAG, which is that older tag. A drift run against it would
# compare the column backwards and call the result "unchanged". The major version stays in the
# module path either way, so this floats within v9 rather than across it.
SUBSTRAIT_GO_COMMIT=main
